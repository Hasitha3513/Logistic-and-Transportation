# Copy this file to .env and fill every required blank value before starting Compose.
POSTGRES_DB=transport_logistics
POSTGRES_USER=transport_app
POSTGRES_PASSWORD=
JWT_SECRET=

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
APP_ADMIN_EMAIL=admin@localhost.test

POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Production EMAIL delivery is disabled unless explicitly enabled.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_MODE=production
NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_REPLY_TO=
NOTIFICATION_EMAIL_CONNECT_TIMEOUT=PT5S
NOTIFICATION_EMAIL_READ_TIMEOUT=PT30S
NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_SMTP_TLS_MODE=starttls
NOTIFICATION_EMAIL_SMTP_AUTH_REQUIRED=true
NOTIFICATION_EMAIL_SMTP_USERNAME=
NOTIFICATION_EMAIL_SMTP_PASSWORD=
